    "hardhat": "^3.14.0",
    "oxlint": "^1.80.0",
    "prisma": "7.10.0",
    "solhint": "^6.2.4",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.0"
  },
  "dependencies": {
