{
  "name": "LINAW-Server",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "dev": "wrangler dev --env local",
    "staging": "wrangler dev --env staging",
    "typecheck": "wrangler types --env-interface CloudflareBindings --check && pnpm tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "trace": "rm -rf dist; pnpm tsc; node --trace-warnings --env-file=.env dist/src/server.js",
    "build": "pnpm prisma generate && tsc -b",
    "generate": "prisma generate",
    "format": "prisma format"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@types/node": "^26.6.5",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.19.0",
    "oxlint": "^1.87.0",
    "prisma": "8.1.0-dev.7",
    "solhint": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.7",
    "@hono/zod-validator": "^0.9.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
