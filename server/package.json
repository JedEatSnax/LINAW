{
  "name": "LINAW-Server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "rm -rf dist; pnpm tsc; node --env-file=.env dist/src/server.js",
    "dev": "node --env-file=.env.local --watch server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "trace": "rm -rf dist; pnpm tsc; node --trace-warnings --env-file=.env dist/src/server.js",
    "build": "tsc -b",
    "generate": "prisma generate",
    "format": "prisma format"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chai": "^6.2.2",
    "eslint": "^10.9.0",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.14.0",
    "mocha": "^11.8.0",
    "prisma": "^7.9.1",
    "solhint": "^6.2.4",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "elliptic": "^6.6.1",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
